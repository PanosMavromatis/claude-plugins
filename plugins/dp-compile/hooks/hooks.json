{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/pre-commit-check.py",
            "timeout": 600,
            "statusMessage": "Checking whether this commit touches a kernel..."
          }
        ]
      }
    ]
  }
}
