--- a/close-revision.sh
+++ b/close-revision.sh
@@ -220,7 +220,7 @@
       *) refuse "revision $LABEL is not open: $ROOT_PLAN:$IDX_N marks it [$mk]" "$NOTOPEN" ;;
     esac
   fi
-  out="$(src "$REV" | awk 'got { next } /^\*\*Status\*\*:/ { v = $0; sub(/^\*\*Status\*\*:[ \t]*/, "", v); sub(/[ \t\r]+$/, "", v); print NR "\t" v; got = 1 }')" \
