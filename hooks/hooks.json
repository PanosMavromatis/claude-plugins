{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-commit-check.sh",
            "timeout": 300,
            "statusMessage": "Running tests for all compiled backends before committing..."
          }
        ]
      }
    ]
  }
}
